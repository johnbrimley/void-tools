#!/bin/bash
# Create a new runit service and enable it.
# Usage: svc-create <name> <command...>
# Example: svc-create mysite node /path/to/app.js

SV_DIR="/etc/sv"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -z "$1" || -z "$2" ]]; then
    echo "Usage: svc-create <name> <command...>" >&2
    echo "Example: svc-create mysite node /path/to/app.js" >&2
    exit 1
fi

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: svc-create requires root privileges." >&2
    echo "Try: sudo svc-create $*" >&2
    exit 1
fi

service="$1"
shift

# If the binary name contains a space the user likely quoted the whole command
# as a single string (e.g. "node /path/to/app.js"). That isn't supported —
# pass each argument separately instead.
if [[ "$1" == *" "* ]]; then
    echo "ERROR: the command must be passed as separate arguments, not as a single quoted string." >&2
    echo "" >&2
    echo "  Wrong: svc-create ${service} \"$*\"" >&2
    echo "  Right: svc-create ${service} $*" >&2
    exit 1
fi

svc_cmd=""
for arg in "$@"; do
    svc_cmd+="\"${arg//\"/\\\"}\" "
done
svc_cmd="${svc_cmd% }"

echo ""
echo "Note: svlogd only captures stdout. Without '2>&1', stderr from your service will be lost."
read -r -p "Append '2>&1' to capture all output? [Y/n] " answer
if [[ -z "$answer" || "$answer" == "y" || "$answer" == "Y" ]]; then
    svc_cmd+=" 2>&1"
fi
echo ""

sv_path="${SV_DIR}/${service}"

if [[ -d "$sv_path" ]]; then
    echo "ERROR: A service named '${service}' already exists at ${sv_path}." >&2
    echo "Choose a different name or remove the existing service with svc-delete." >&2
    exit 1
fi

echo "Creating service '${service}'..."
trap 'rm -rf "${sv_path}"; echo "ERROR: creation failed, rolled back ${sv_path}." >&2' ERR

mkdir -p "${sv_path}"

cat > "${sv_path}/run" <<EOF
#!/bin/bash
# void-tools:managed
exec ${svc_cmd}
EOF
chmod +x "${sv_path}/run"
echo "  created ${sv_path}/run"

mkdir -p "${sv_path}/log"
mkdir -p "/var/log/${service}"
cat > "${sv_path}/log/run" <<EOF
#!/bin/bash
# void-tools:managed
exec svlogd -tt /var/log/${service}
EOF
chmod +x "${sv_path}/log/run"
echo "  created ${sv_path}/log/run"
echo "  created /var/log/${service}"

trap - ERR

echo ""
echo "Enabling service..."
"${SCRIPT_DIR}/svc-add" "$service"
