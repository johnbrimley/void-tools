#!/bin/bash
# Search available packages by name or description.
# Usage: pkg-search <query>

if [[ -z "$1" ]]; then
    echo "Usage: pkg-search <query>" >&2
    exit 1
fi

echo "Searching for '$*'..."
echo ""
xbps-query -Rs "$*"
status=$?

if [[ $status -ne 0 ]]; then
    echo "No packages found matching '$*'." >&2
    exit $status
fi
