#!/bin/bash
# Install one or more packages with xbps.
# Usage: pkg-install <package> [package...]

if [[ -z "$1" ]]; then
    echo "Usage: pkg-install <package> [package...]" >&2
    echo "Tip:   use pkg-search to find package names." >&2
    exit 1
fi

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: pkg-install requires root privileges." >&2
    echo "Try: sudo pkg-install $*" >&2
    exit 1
fi

echo "Installing: $*"
echo ""
xbps-install -S "$@"
status=$?

if [[ $status -ne 0 ]]; then
    echo "" >&2
    echo "Installation failed. If the package name is wrong, try:" >&2
    for pkg in "$@"; do
        echo "  pkg-search ${pkg}" >&2
    done
    exit $status
fi
