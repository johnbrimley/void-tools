#!/bin/bash
# List installed packages, with optional filter terms (AND semantics).
# Usage: pkg-list [term...]

if [[ -n "$1" ]]; then
    echo "Installed packages matching '$*':"
    echo ""
    result="$(xbps-query -l)"
    for term in "$@"; do
        result="$(echo "$result" | grep -i "$term")"
    done
    if [[ -z "$result" ]]; then
        echo "No installed packages matching '$*'." >&2
        echo "Tip: use pkg-search to find packages available to install." >&2
        exit 1
    fi
    echo "$result"
else
    echo "Installed packages:"
    echo ""
    xbps-query -l
fi
