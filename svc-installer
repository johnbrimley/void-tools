#!/bin/bash
# Bootstrap void-tools scripts from GitHub.
# Reads the manifest and downloads each listed script to /usr/local/bin/.
# Usage: sudo bash svc-installer

RAW_BASE="https://raw.githubusercontent.com/johnbrimley/void-tools/main"
MANIFEST_URL="${RAW_BASE}/manifest"
INSTALL_DIR="/usr/local/bin"

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: svc-installer requires root privileges." >&2
    echo "Try: sudo bash svc-installer" >&2
    exit 1
fi

# Require xbps-fetch
if ! command -v xbps-fetch &>/dev/null; then
    echo "ERROR: xbps-fetch not found. Are you running Void Linux?" >&2
    exit 1
fi

# All downloads go into a temp directory. xbps-fetch saves each file using
# the URL's basename, so we avoid -o entirely (its stdout behavior is unreliable).
tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

# Fetch the manifest
echo "Fetching manifest from ${MANIFEST_URL}..."
(cd "$tmpdir" && xbps-fetch "$MANIFEST_URL" >/dev/null 2>&1)
if [[ ! -s "$tmpdir/manifest" ]]; then
    echo "ERROR: failed to fetch manifest. Check your network connection." >&2
    exit 1
fi
manifest="$(cat "$tmpdir/manifest")"

# Download each script listed in the manifest
echo ""
echo "Installing scripts to ${INSTALL_DIR}:"
while IFS= read -r name; do
    [[ -z "$name" ]] && continue
    url="${RAW_BASE}/${name}"
    dest="${INSTALL_DIR}/${name}"

    rm -f "$tmpdir/$name"
    (cd "$tmpdir" && xbps-fetch "$url" >/dev/null 2>&1)
    if [[ -f "$tmpdir/$name" ]]; then
        mv "$tmpdir/$name" "$dest"
        chmod +x "$dest"
        echo "  [ok] ${name}"
    else
        echo "  [FAILED] ${name} — could not fetch ${url}" >&2
    fi
done <<< "$manifest"

echo ""
echo "All done. Scripts are ready to use."
